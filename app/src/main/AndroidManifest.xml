<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        BLE communication with dive housing.
        API 30 and below use the legacy trio; scanning there genuinely requires location even
        though the app never uses it, hence the maxSdkVersion caps rather than an unconditional
        location request. From API 31 the scan is declared as never deriving location.
    -->
    <uses-permission android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <!-- Also powers Expert RAW's offline Sky Guide projection; no location leaves the phone. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />

    <!-- Camera for underwater photography -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Foreground service for persistent BLE connection -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Keep screen on while diving -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <uses-feature android:name="android.hardware.bluetooth_le" android:required="true" />
    <uses-feature android:name="android.hardware.camera" android:required="true" />

    <application
        android:name=".DiveControlApp"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:label="DiveControl"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.DiveControl"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.DiveControl"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:windowSoftInputMode="stateAlwaysHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Keeps the housing link alive and the process unfrozen for the whole dive -->
        <service
            android:name=".service.HousingLinkService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!--
            Optional, explicitly user-enabled bridge for operating Android/Samsung permission
            dialogs and DiveControl's page-scoped Location/App-permission settings path after the
            phone is sealed in the housing. It refuses every other system or app window.
        -->
        <service
            android:name=".accessibility.PermissionDialogHousingService"
            android:exported="false"
            android:label="@string/permission_dialog_accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/permission_dialog_accessibility_service" />
        </service>
    </application>
</manifest>
